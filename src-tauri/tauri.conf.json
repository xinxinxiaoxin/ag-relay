{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ag-relay",
  "version": "0.3.4",
  "identifier": "ag-relay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4318",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/prepare-distribution.mjs && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AG Relay · 网关",
        "decorations": false,
        "shadow": true,
        "theme": "Light",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "wix": {
        "upgradeCode": "ba1f2de2-325d-5641-9f4f-cdc34e692497",
        "language": "zh-CN",
        "fragmentPaths": [
          "windows/installer-policy.wxs"
        ],
        "componentRefs": [
          "AGRelayInstallerSafety"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/gateway/": "resources/gateway/",
      "generated/license-distribution/installer/": "licenses/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxOTEwQjA3OUQ2MTAyMDEKUldRQkFtR2RCd3VSNFFJU3I1SE55eEpiVldqblBsclltRzVyRnZzWXJ0QWg4YkJSeStOdlc5YncK",
      "endpoints": [
        "https://github.com/xinxinxiaoxin/ag-relay/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
